# Copy to .env and fill in. Never commit .env.

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# model used to read figures/tables (must support images)
GEMINI_VISION_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# requests per minute your plan allows (free tier ~15 -> keep 14). 0 = no pacing (paid tier)
LLM_RPM=14
# longest wait (s) accepted when Gemini says "retry in N s"; daily-quota waits longer than this give up
LLM_MAX_WAIT_S=90

# --- Embeddings / reranker ---
EMBEDDING_BACKEND=qwen
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
USE_RERANKER=true

# --- Qdrant (leave QDRANT_URL empty for local file mode) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=researchiq_chunks

# --- Retrieval ---
DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANK_TOP_N=24
FINAL_TOP_K=8
MAX_CHUNKS_PER_PAPER=4
MIN_RERANK_SCORE=-4.0

# --- Chunking ---
CHUNK_MAX_WORDS=320
CHUNK_OVERLAP_WORDS=40

# --- Uploads / features ---
MAX_UPLOAD_MB=40
MAX_PAGES=120
DESCRIBE_FIGURES=true

# --- OCR (Tesseract) for scanned pages ---
ENABLE_OCR=true
# Full path to tesseract only if it is NOT on your PATH, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# language pack(s), e.g. eng or eng+deu
OCR_LANG=eng
# image resolution used for OCR (300 = good accuracy, 200 = faster)
OCR_DPI=300
# words below this Tesseract confidence (0-100) are dropped
OCR_MIN_CONF=40
# pages with fewer extractable characters than this are treated as scanned
OCR_TEXT_THRESHOLD=40
# true = OCR every page even if it has text (testing / broken text layers)
OCR_FORCE=false
VERIFY_CITATIONS_WITH_LLM=false

# --- Frontend ---
BACKEND_URL=http://localhost:8000
